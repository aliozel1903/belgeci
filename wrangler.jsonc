// Cloudflare Workers ayarı: web/ klasörünü statik site olarak yayınlar (derleme adımı yok).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "belgeci",
  "compatibility_date": "2026-11-01",
  // workers.dev adresleri kapalı: site yalnızca panelden eklenen kendi alan adından yayınlanır.
  // Kendi alan adınız yoksa ikisini de true yapın.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./web"
  }
}
